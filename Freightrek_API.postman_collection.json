                  "value": "65abc123def456789",
                  "description": "Hub ObjectId"
                }
              ]
            },
            "description": "Update an existing hub. Requires authentication."
          },
          "response": []
        },
        {
          "name": "Delete Hub",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/hub/:id",
              "host": ["{{base_url}}"],
              "path": ["admin", "hub", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "65abc123def456789",
                  "description": "Hub ObjectId"
                }
              ]
            },
            "description": "Delete a hub. Requires authentication and proper permissions."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Server Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Check if server is running. No authentication required."
          },
          "response": []
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  }
}
