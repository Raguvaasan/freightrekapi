{
  "info": {
    "name": "Freightrek Server API",
    "description": "API collection for Freightrek Server with authentication and RBAC",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "freightrek-v1"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Admin User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.test(\"User registered successfully\", function () {",
                  "        pm.response.to.have.status(201);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Admin\",\n  \"email\": \"admin@freightrek.com\",\n  \"phoneNo\": \"1234567890\",\n  \"password\": \"Admin@123\",\n  \"roleId\": \"65abc123def456789\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/auth/register",
              "host": ["{{base_url}}"],
              "path": ["admin", "auth", "register"]
            },
            "description": "Register a new admin user. Requires a valid roleId from the database."
          },
          "response": []
        },
        {
          "name": "Login Admin User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"auth_token\", jsonData.token);",
                  "    pm.collectionVariables.set(\"auth_token\", jsonData.token);",
                  "    pm.test(\"Login successful and token saved\", function () {",
                  "        pm.expect(jsonData.token).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@freightrek.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/auth/login",
              "host": ["{{base_url}}"],
              "path": ["admin", "auth", "login"]
            },
            "description": "Login with email and password. Returns JWT token that is automatically saved to collection variable."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Role Management",
      "item": [
        {
          "name": "Create Role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Manager\",\n  \"permissions\": [\"read\", \"write\"],\n  \"status\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/role",
              "host": ["{{base_url}}"],
              "path": ["admin", "role"]
            },
            "description": "Create a new role with permissions. Requires authentication."
          },
          "response": []
        },
        {
          "name": "Get All Roles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/role",
              "host": ["{{base_url}}"],
              "path": ["admin", "role"]
            },
            "description": "Retrieve all roles. Requires authentication."
          },
          "response": []
        },
        {
          "name": "Get Role by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/role/:id",
              "host": ["{{base_url}}"],
              "path": ["admin", "role", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "65abc123def456789",
                  "description": "Role ObjectId"
                }
              ]
            },
            "description": "Retrieve a specific role by ID. Requires authentication."
          },
          "response": []
        },
        {
          "name": "Update Role",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Senior Manager\",\n  \"permissions\": [\"read\", \"write\", \"delete\"],\n  \"status\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/role/:id",
              "host": ["{{base_url}}"],
              "path": ["admin", "role", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "65abc123def456789",
                  "description": "Role ObjectId"
                }
              ]
            },
            "description": "Update an existing role. Requires authentication."
          },
          "response": []
        },
        {
          "name": "Delete Role",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/role/:id",
              "host": ["{{base_url}}"],
              "path": ["admin", "role", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "65abc123def456789",
                  "description": "Role ObjectId"
                }
              ]
            },
            "description": "Delete a role. Requires authentication and proper permissions."
          },
          "response": []
        }
      ]
    },
    {
