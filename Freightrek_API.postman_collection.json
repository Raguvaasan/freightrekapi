              "raw": "{\n  \"name\": \"Mumbai Central Hub\",\n  \"location\": \"Mumbai Central, Maharashtra\",\n  \"capacity\": 1500,\n  \"status\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/hub/:id",
              "host": ["{{base_url}}"],
