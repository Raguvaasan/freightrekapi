{
  "info": {
    "name": "Freightrek Delhivery B2C APIs",
    "description": "Stubbed Delhivery B2C endpoints exposed by Freightrek server",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" }
  ],
  "item": [
    { "name": "Pincode Serviceability", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"pin\": \"110001\"\n}" }, "url": { "raw": "{{base_url}}/delhivery/pincode-serviceability", "host": ["{{base_url}}"], "path": ["delhivery","pincode-serviceability"] } } },
    { "name": "Fetch Waybill", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"count\": 10\n}" }, "url": { "raw": "{{base_url}}/delhivery/fetch-waybill", "host": ["{{base_url}}"], "path": ["delhivery","fetch-waybill"] } } },
    { "name": "Shipment Manifestation", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"ORDER123\"\n}" }, "url": { "raw": "{{base_url}}/delhivery/shipment/manifest", "host": ["{{base_url}}"], "path": ["delhivery","shipment","manifest"] } } },
    { "name": "Shipment Updation", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"waybill\": \"WB123\",\n  \"updates\": {\n    \"status\": \"InTransit\"\n  }\n}" }, "url": { "raw": "{{base_url}}/delhivery/shipment/update", "host": ["{{base_url}}"], "path": ["delhivery","shipment","update"] } } },
    { "name": "Shipment Cancellation", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"waybill\": \"WB123\"\n}" }, "url": { "raw": "{{base_url}}/delhivery/shipment/cancel", "host": ["{{base_url}}"], "path": ["delhivery","shipment","cancel"] } } },
    { "name": "E-waybill Management", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"waybill\": \"WB123\",\n  \"ewaybillNumber\": \"EW123\"\n}" }, "url": { "raw": "{{base_url}}/delhivery/ewaybill", "host": ["{{base_url}}"], "path": ["delhivery","ewaybill"] } } },
    { "name": "Shipment Tracking", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"waybill\": \"WB123\"\n}" }, "url": { "raw": "{{base_url}}/delhivery/shipment/track", "host": ["{{base_url}}"], "path": ["delhivery","shipment","track"] } } },
    { "name": "Calculate Shipping Cost", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"fromPincode\": \"110001\",\n  \"toPincode\": \"560001\",\n  \"weight\": 1.2\n}" }, "url": { "raw": "{{base_url}}/delhivery/shipping-cost", "host": ["{{base_url}}"], "path": ["delhivery","shipping-cost"] } } },
    { "name": "Generate Shipping Label", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"waybill\": \"WB123\"\n}" }, "url": { "raw": "{{base_url}}/delhivery/label", "host": ["{{base_url}}"], "path": ["delhivery","label"] } } },
    { "name": "Pickup Request Creation", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"pickupLocation\": \"BLR-WH\",\n  \"shipments\": [\"WB123\", \"WB124\"]\n}" }, "url": { "raw": "{{base_url}}/delhivery/pickup", "host": ["{{base_url}}"], "path": ["delhivery","pickup"] } } },
    { "name": "Client Warehouse Creation", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"name\": \"BLR Warehouse\",\n  \"address\": \"Address here\",\n  \"pincode\": \"560001\"\n}" }, "url": { "raw": "{{base_url}}/delhivery/warehouse", "host": ["{{base_url}}"], "path": ["delhivery","warehouse"] } } },
    { "name": "Client Warehouse Updation", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"warehouseId\": \"65abc123def456789\",\n  \"name\": \"Updated Warehouse\"\n}" }, "url": { "raw": "{{base_url}}/delhivery/warehouse/update", "host": ["{{base_url}}"], "path": ["delhivery","warehouse","update"] } } },
    { "name": "Webhook Configuration", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"url\": \"https://example.com/webhook\",\n  \"events\": [\"status_change\"]\n}" }, "url": { "raw": "{{base_url}}/delhivery/webhook", "host": ["{{base_url}}"], "path": ["delhivery","webhook"] } } },
    { "name": "Download Document", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"waybill\": \"WB123\"\n}" }, "url": { "raw": "{{base_url}}/delhivery/document", "host": ["{{base_url}}"], "path": ["delhivery","document"] } } },
    { "name": "RVP QC 3.0", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"ORDER123\"\n}" }, "url": { "raw": "{{base_url}}/delhivery/rvp-qc", "host": ["{{base_url}}"], "path": ["delhivery","rvp-qc"] } } },
    { "name": "NDR Action", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"waybill\": \"WB123\",\n  \"action\": \"REATTEMPT\"\n}" }, "url": { "raw": "{{base_url}}/delhivery/ndr", "host": ["{{base_url}}"], "path": ["delhivery","ndr"] } } }
  ]
}
